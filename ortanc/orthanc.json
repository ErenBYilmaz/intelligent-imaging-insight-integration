    "DataSource" : "dicom-web"
  },
  "DicomWeb" : {
    "Enable" : true,
    "Root": "/dicom-web/"
  },
  "RegisteredUsers": {
    "demo": "demo"
  },
  "PostgreSQL": {
    "Host": "orthanc-index"
  },
  "DicomModalities" : {
    "PYTHON_AET":  [ "PYTHON_AET", "host.docker.internal", 104]
  }
}
